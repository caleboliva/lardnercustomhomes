---
import '@fontsource-variable/jost/wght.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import logo from '../assets/brand/lardner-custom-homes-logo.webp';
// The two typefaces seen first on every page. Preloading them shortens the moment text shows in
// a fallback font. The same files are referenced by the font CSS, so nothing downloads twice.
import cormorantLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { copy } from '../data/copy.ts';
import { site } from '../data/site.ts';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteImage } from '../lib/images.ts';
import { breadcrumbSchema, businessSchema, keywordList } from '../lib/seo.ts';

interface Props {
  title: string;
  description?: string;
  /** Set to false for immersive pages that supply their own way out (the project view). */
  header?: boolean;
  /** Let the page's first section run under a see-through header. The page must start with a hero. */
  headerOverlay?: boolean;
  /** What search engines and link previews read. See src/data/seo.ts. */
  seo?: {
    /** Replaces `title` in search results and browser tabs. The company name is added after it. */
    title?: string;
    keywords?: string[];
    /** The picture shown when the page is shared. Defaults to the home page hero. */
    image?: ImageMetadata | null;
    /** Describes `image` for link previews that read it aloud. */
    imageAlt?: string;
    /** Keep the page out of search results. */
    noindex?: boolean;
    /** Extra structured data for this page. */
    schema?: object[];
  };
}

const { title, description = site.description, header = true, headerOverlay = false, seo = {} } = Astro.props;
const searchTitle = seo.title ?? title;
const pageTitle = searchTitle === site.name ? searchTitle : `${searchTitle} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const keywords = keywordList(seo.keywords ?? []);

// Link previews want a 1200 × 630 JPG at a full web address.
const absolute = (path: string) => new URL(path, Astro.site).href;
const shareImage = async (image: ImageMetadata) =>
  absolute((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src);
const heroImage = siteImage(copy.home.hero.slides[0]?.image ?? null);
const defaultShare = heroImage ? await shareImage(heroImage) : undefined;
const share = seo.image ? await shareImage(seo.image) : defaultShare;
const shareAlt = seo.image ? seo.imageAlt : copy.home.hero.slides[0]?.alt;
const logoUrl = absolute((await getImage({ src: logo, width: 512, format: 'png' })).src);

const schemas: object[] = [businessSchema({ image: defaultShare, logo: logoUrl })];
const breadcrumbs = breadcrumbSchema(Astro.url.pathname, title);
if (breadcrumbs) schemas.push(breadcrumbs);
schemas.push(...(seo.schema ?? []));
// "<" is escaped so no text in the data can close the script tag early.
const toJson = (schema: object) => JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#f8f8f6" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      share && (
        <Fragment>
          <meta property="og:image" content={share} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
        </Fragment>
      )
    }
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    {schemas.map((schema) => <script type="application/ld+json" is:inline set:html={toJson(schema)} />)}
  </head>
  <body data-site-header={!header ? 'off' : headerOverlay ? 'overlay' : 'on'}>
    <a class="skip-link" href="#main">Skip to content</a>
    {header && <Header overlay={headerOverlay} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initNav } from '../scripts/nav.ts';
      import { initReveal } from '../scripts/reveal.ts';
      initNav();
      initReveal();
    </script>
  </body>
</html>
