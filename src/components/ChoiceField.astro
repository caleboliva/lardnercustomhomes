---
import FieldError from './FieldError.astro';

interface Props {
  name: string;
  legend: string;
  options: readonly string[];
  required?: boolean;
  /** Let the visitor tick more than one. */
  multiple?: boolean;
}

const { name, legend, options, required = false, multiple = false } = Astro.props;
const id = `inq-${name}`;
---

<fieldset class="field" data-field={name} role={multiple ? 'group' : 'radiogroup'} aria-labelledby={`${id}-legend`} aria-required={required ? 'true' : undefined}>
  <legend class="field__label" id={`${id}-legend`}>{legend}{required && <Fragment>{' '}<span aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></Fragment>}</legend>
  <div class="choices">
    {
      options.map((option, i) => (
        <span class="choice">
          <input class="choice__input" type={multiple ? 'checkbox' : 'radio'} id={`${id}-${i}`} name={name} value={option} required={required && !multiple} />
          <label class="choice__label" for={`${id}-${i}`}>{option}</label>
        </span>
      ))
    }
  </div>
  <FieldError id={`${id}-error`} />
</fieldset>
