---
import { Image } from 'astro:assets';
import type { PressItem } from '../data/press.ts';
import { pressLogo } from '../lib/images.ts';
import { logoHeight } from '../lib/logo-size.ts';

interface Props {
  item: PressItem;
  /** 1 on the home page; smaller beside an article. */
  scale?: number;
}

const { item, scale = 1 } = Astro.props;
const logo = pressLogo(item.logo);
const rem = logo ? logoHeight(logo.width, logo.height, scale * (item.logoScale ?? 1)) : 0;
const height = Math.round(rem * 16);
const width = logo ? Math.round((height * logo.width) / logo.height) : 0;
---

<span class="press-logo" style={logo ? `--logo-h: ${rem}rem` : undefined}>
  {logo ? <Image src={logo} alt={item.outlet} width={width} height={height} densities={[1, 2]} /> : item.outlet}
</span>

<style>
  .press-logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .press-logo :global(img) {
    width: auto;
    height: calc(var(--logo-h) * var(--logo-scale, 1));
  }

  @media (max-width: 40rem) {
    .press-logo {
      --logo-scale: 0.8;
    }
  }
</style>
