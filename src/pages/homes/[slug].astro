---
import Copy from '../../components/Copy.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import LightboxTrigger from '../../components/LightboxTrigger.astro';
import Photo from '../../components/Photo.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { copy } from '../../data/copy.ts';
import { listings } from '../../data/homes.ts';
import { neighborhoods } from '../../data/neighborhoods.ts';
import type { Listing } from '../../data/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { placeholder } from '../../lib/format.ts';
import { homeImage, toGalleryItem } from '../../lib/images.ts';
import { listingFacts } from '../../lib/listing-facts.ts';
import { mapEmbedUrl, mapLinkUrl } from '../../lib/maps.ts';
import { listingSchema, listingSeo } from '../../lib/seo.ts';

export function getStaticPaths() {
  return listings.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const isLot = listing.category === 'lot';
const cover = homeImage(listing.slug, listing.cover);
const coverAlt = listing.coverAlt ?? listing.photos.find((photo) => photo.file === listing.cover)?.alt ?? listing.title;
// A square or tall cover, such as a lot drawing, is shown whole beside the details.
// A wide one runs across the page as a banner.
const wholeCover = cover !== null && cover.width / cover.height < 1.25;
const coverItem = wholeCover ? await toGalleryItem(cover, coverAlt, listing.title) : null;
const items = await Promise.all(
  listing.photos.map((photo) => toGalleryItem(homeImage(listing.slug, photo.file), photo.alt, listing.title)),
);

const facts = listingFacts(listing);

const description =
  listing.description ?? (listing.placeholder ? placeholder(`a short description of this ${isLot ? 'lot' : 'home'}`) : '');
const back = isLot ? { href: '/homes/lots/', label: 'All lots' } : { href: '/homes/available/', label: 'Available homes' };
const inquiryHref = `/inventory/?home=${encodeURIComponent(listing.title)}`;
const { location, plannedHome, aboutNeighborhood } = copy.homes;
const areaText = listing.neighborhood ? (neighborhoods[listing.neighborhood] ?? []) : [];
// In the local preview, outlined boxes mark where text can still be added. They never reach
// the live site.
const showHints = import.meta.env.DEV;

const seo = listingSeo(listing);
const shared = items.flatMap((item) => (item.full ? [new URL(item.full.src, Astro.site).href] : [])).slice(0, 6);
const schema = listingSchema(listing, new URL(Astro.url.pathname, Astro.site).href, shared);
---

<BaseLayout
  title={listing.title}
  description={seo.description}
  seo={{ title: seo.title, keywords: seo.keywords, image: cover, schema: [schema] }}
>
  <article class="listing">
    <header class="listing__header container">
      <a class="listing__back" href={back.href}><span aria-hidden="true">&larr;</span> {back.label}</a>
      <p class="eyebrow">{listing.status}</p>
      <h1>{listing.title}</h1>
    </header>

    <div class:list={['listing__top container', { 'listing__top--whole': wholeCover }]}>
      <figure class="listing__cover" data-lightbox-group={coverItem ? '' : undefined}>
        {
          coverItem ? (
            <LightboxTrigger item={coverItem}>
              <Photo image={cover} alt={coverAlt} ratio="natural" sizes="(min-width: 64rem) 46vw, 92vw" eager />
            </LightboxTrigger>
          ) : (
            <Photo
              image={cover}
              alt={coverAlt}
              ratio="16/9"
              sizes="(min-width: 90rem) 82rem, 92vw"
              eager
              placeholderLabel={isLot ? 'Lot photo' : 'Home photo'}
            />
          )
        }
        {listing.coverCaption && <figcaption class="listing__caption">{listing.coverCaption}</figcaption>}
      </figure>

      <section class="listing__summary" aria-label="Details">
        <dl class="listing__facts">
          {
            facts.map((fact) => (
              <div class="listing__fact">
                <dt>{fact.label}</dt>
                <dd><Copy text={fact.value} /></dd>
              </div>
            ))
          }
        </dl>
        <div class="listing__about">
          {isLot && (description || showHints) && <h2 class="listing__subhead">{plannedHome}</h2>}
          {
            description ? (
              <p class="lead"><Copy text={description} /></p>
            ) : (
              showHints && (
                <p class="listing__hint">Room for a description of {isLot ? 'the planned home' : 'this home'}: add <code>description</code> to this listing in src/data/homes.ts. This box only shows in the local preview.</p>
              )
            )
          }
          <a class="btn" href={inquiryHref}>{isLot ? copy.homes.lotDetailCta : copy.homes.detailCta}</a>
        </div>
      </section>
    </div>

    {
      items.length > 0 && (
        <section class="listing__photos container" aria-labelledby="photos-heading">
          <h2 id="photos-heading">{listing.photosHeading ?? 'Photos'}</h2>
          <PhotoGrid items={items} layout="three" ratio="4/3" />
        </section>
      )
    }

    {
      listing.neighborhood && (areaText.length > 0 || showHints) && (
        <section class="listing__area container" aria-labelledby="area-heading">
          <h2 id="area-heading">{aboutNeighborhood} {listing.neighborhood}</h2>
          {areaText.length > 0 ? (
            <div class="prose">
              {areaText.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ) : (
            <p class="listing__hint">Room for a few paragraphs about {listing.neighborhood}: add them to src/data/neighborhoods.ts. They will show on every listing in {listing.neighborhood}. This box only shows in the local preview.</p>
          )}
        </section>
      )
    }

    {
      listing.address && (
        <section class="listing__location container" aria-labelledby="location-heading">
          <div class="listing__location-text">
            <h2 id="location-heading">{location.heading}</h2>
            <p class="listing__address"><Icon name="pin" size={20} /> {listing.address}</p>
            <a class="link-arrow" href={mapLinkUrl(listing.address)} target="_blank" rel="noopener noreferrer">{location.link}<span class="visually-hidden"> (opens in a new tab)</span></a>
          </div>
          <iframe
            class="listing__map"
            title={`Map with a pin at ${listing.address}`}
            src={mapEmbedUrl(listing.address)}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </section>
      )
    }
  </article>
  <Lightbox />
</BaseLayout>

<style>
  .listing__header {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block: var(--space-7) var(--space-6);
  }

  .listing__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .listing__top {
    display: grid;
    gap: calc(var(--space-section) * 0.6);
    padding-bottom: calc(var(--space-section) * 0.6);
  }

  .listing__cover {
    margin: 0;
  }

  .listing__caption {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .listing__summary {
    display: grid;
    gap: var(--space-7);
  }

  .listing__facts {
    display: grid;
    align-content: start;
    margin: 0;
  }

  .listing__fact {
    display: grid;
    gap: var(--space-1) var(--space-5);
    grid-template-columns: 9rem minmax(0, 1fr);
    padding-block: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .listing__fact dt {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    line-height: 2;
    text-transform: uppercase;
  }

  .listing__about {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-5);
  }

  .listing__subhead {
    font-size: var(--step-2);
  }

  .listing__hint {
    max-width: var(--measure);
    padding: var(--space-4);
    border: 1px dashed var(--field-border);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .listing__area {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-section);
  }

  .listing__photos {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-section);
  }

  .listing__location {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-section);
  }

  .listing__location-text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  .listing__address {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .listing__map {
    display: block;
    width: 100%;
    height: clamp(18rem, 50vw, 28rem);
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  @media (min-width: 64rem) {
    .listing__summary {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-9);
    }

    /* The whole cover sits on the left and the details stack on the right. */
    .listing__top--whole {
      align-items: start;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-8);
    }

    .listing__top--whole .listing__summary {
      grid-template-columns: minmax(0, 1fr);
    }

    .listing__area {
      align-items: start;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-8);
    }

    .listing__location {
      align-items: start;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-8);
    }
  }
</style>
