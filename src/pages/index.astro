---
import { pageSeo } from '../data/seo.ts';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PressLogo from '../components/PressLogo.astro';
import { copy } from '../data/copy.ts';
import { pressOutlets } from '../data/press.ts';
import { projects } from '../data/projects.ts';
import { site } from '../data/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects } from '../lib/content.ts';
import { signupHref } from '../lib/validation.ts';

const { intro, featured, press, neighborhoods, quote, cta } = copy.home;
const outlets = pressOutlets();
const featuredList = featuredProjects(projects, 3);
const seo = pageSeo.home;
---

<BaseLayout title={site.name} description={seo.description} seo={seo} headerOverlay>
  <HeroSlideshow />

  <section class="intro section container" aria-labelledby="intro-title">
    <div class="intro__heading" data-reveal>
      <p class="eyebrow">{intro.eyebrow}</p>
      <h2 id="intro-title">{intro.heading}</h2>
    </div>
    <div class="intro__body prose" data-reveal style="--reveal-i: 1">
      {intro.body.map((paragraph) => <p>{paragraph}</p>)}
      <p><a class="link-arrow" href="/about/">{intro.link}</a></p>
    </div>
  </section>


  {
    featuredList.length > 0 && (
      <section class="featured section section--tight container" aria-labelledby="featured-title">
        <div class="featured__header" data-reveal>
          <div>
            <p class="eyebrow">{featured.eyebrow}</p>
            <h2 id="featured-title">{featured.heading}</h2>
          </div>
          <a class="link-arrow" href="/gallery/">{featured.link}</a>
        </div>
        <ul class="grid grid--3" role="list">
          {featuredList.map((project, i) => (
            <li data-reveal style={`--reveal-i: ${i}`}>
              <ProjectCard
                project={project}
                headingLevel={3}
                sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    outlets.length > 0 && (
      <section class="press-line container" aria-labelledby="press-line-title" data-reveal>
        <h2 class="eyebrow" id="press-line-title">{press.heading}</h2>
        <ul class="press-line__list" role="list">
          {outlets.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer"><PressLogo item={item} scale={1.45} /><span class="visually-hidden">{`: ${item.title} (opens in a new tab)`}</span></a>
            </li>
          ))}
        </ul>
        <a class="link-arrow" href="/about/#press">{press.link}</a>
      </section>
    )
  }

  <section class="section section--dark" data-theme="dark" aria-labelledby="neighborhoods-title">
    <div class="neighborhoods container" data-reveal>
      <h2 class="eyebrow" id="neighborhoods-title">{neighborhoods.eyebrow}</h2>
      <ul class="neighborhoods__list" role="list">
        {neighborhoods.names.map((name) => <li>{name}</li>)}
      </ul>
      <p class="neighborhoods__note">{neighborhoods.note}</p>
    </div>
  </section>

  <section class="section container" aria-label="A word from Colin Lardner">
    <figure class="quote" data-reveal>
      <blockquote><p>&ldquo;{quote.text}&rdquo;</p></blockquote>
      <figcaption class="eyebrow">{quote.attribution}</figcaption>
    </figure>
  </section>

  <section class="section section--accent" aria-labelledby="cta-title">
    <div class="cta container" data-reveal>
      <h2 id="cta-title">{cta.heading}</h2>
      <p class="lead">{cta.body}</p>
      <a class="btn" href={signupHref()}>{cta.button}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-6);
  }

  .intro__heading {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .featured {
    display: grid;
    gap: var(--space-7);
  }

  .featured__header {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }

  .featured__header > div {
    display: grid;
    gap: var(--space-3);
  }

  .press-line {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding-block: var(--space-8) calc(var(--space-section) * 0.7);
    text-align: center;
  }

  .press-line__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-5) var(--space-9);
    margin: 0;
  }

  .press-line__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .press-line__list a:hover,
  .press-line__list a:focus-visible {
    opacity: 1;
  }

  @media (max-width: 40rem) {
    .press-line__list {
      gap: var(--space-4) var(--space-6);
    }
  }

  .neighborhoods {
    display: grid;
    gap: var(--space-5);
  }

  .neighborhoods__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-7);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .neighborhoods__note {
    color: var(--text-muted);
    font-style: italic;
  }

  .quote {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }

  .quote blockquote {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-style: italic;
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .cta {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .cta .btn {
    margin-top: var(--space-3);
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-9);
    }
  }
</style>
